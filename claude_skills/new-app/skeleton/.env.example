# ─── Database ────────────────────────────────────────────────────────────────
# @@PREFIX@@_DB_HOST is the postgres container name — do not change it.
@@PREFIX@@_DB_HOST=@@SLUG@@_db
@@PREFIX@@_DB_PORT=5432
@@PREFIX@@_DB_NAME=@@SLUG@@_db
@@PREFIX@@_DB_USER=@@SLUG@@_user
@@PREFIX@@_DB_PASSWORD=CHANGE_me_strong_db_pw

# Host-side postgres port (change if it clashes with another local postgres).
@@PREFIX@@_DB_PORT_HOST=5439

# ─── App ports (host side) ───────────────────────────────────────────────────
@@PREFIX@@_FRONTEND_PORT=3100
@@PREFIX@@_BACKEND_PORT=5100

# ─── Flask ───────────────────────────────────────────────────────────────────
@@PREFIX@@_FLASK_ENV=production
