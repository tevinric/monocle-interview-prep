# Frontend build/runtime vars (VITE_* are baked into the build).
# Backend API base URL for local `npm run dev`. In production the nginx proxy
# serves the API from the same origin, so this is ignored.
VITE_LENS_API_URL=http://localhost:5100

# Sign-in needs no build-time variable: the browser asks the API for the tenant,
# client id and scope at startup (GET /api/auth/config), so one frontend image
# serves every environment. Those values come from the Key Vault — see
# ../docs/ENTRA_SETUP.md.
