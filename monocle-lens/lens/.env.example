# =============================================================================
# Lens — optional host-side overrides (NOT secrets)
# =============================================================================
# The OpenAI API key and the database credentials live in Azure Key Vault and are fetched
# at startup by the keyvault-init container. Nothing in this file is a credential, and
# nothing here is required: every value below already has a committed default in
# docker-compose.yml. Uncomment only what you need to change on this machine. Every run
# records the effective configuration (runs.config_json), so overrides stay traceable.

# ─── Host ports (change if they clash with another stack) ────────────────────
LENS_FRONTEND_PORT=3100
LENS_BACKEND_PORT=5100
LENS_DB_PORT_HOST=5439

# ─── Models ──────────────────────────────────────────────────────────────────
# Defaults: chat gpt-5.6-luna ($0.20/$1.20 per 1M), judge gpt-5-nano ($0.05/$0.40),
# embeddings text-embedding-3-small ($0.02 per 1M, 1536 dimensions).
# LENS_CHAT_MODEL=gpt-5.6-luna
# LENS_JUDGE_MODEL=gpt-5-nano
# LENS_EMBEDDING_MODEL=text-embedding-3-small
#
# Changing the embedding model also means changing vector(1536) in database/sql_init.sql
# AND the _SCHEMA_SQL block in backend/app.py, then re-ingesting.
#
# Point at a compatible gateway or proxy if you use one:
# LENS_OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Agent behaviour ─────────────────────────────────────────────────────────
# Reasoning models (gpt-5*, gpt-6*, o*) use reasoning_effort and ignore temperature;
# older models (gpt-4o, gpt-4.1) use temperature and ignore reasoning_effort.
# LENS_REASONING_EFFORT=low        # none|low|medium|high|xhigh
# LENS_LLM_TEMPERATURE=0
# LENS_LLM_MAX_TOKENS=8000         # reasoning models: covers reasoning + answer
# LENS_LLM_TIMEOUT_SECONDS=90
# LENS_MAX_TOOL_ITERATIONS=3
# LENS_CONFIDENCE_THRESHOLD=0.55

# ─── Cost (USD per 1K tokens) ────────────────────────────────────────────────
# LENS_COST_PER_1K_INPUT=0.0002
# LENS_COST_PER_1K_OUTPUT=0.0012
# LENS_COST_PER_1K_EMBEDDING=0.00002

# ─── Modes ───────────────────────────────────────────────────────────────────
# LENS_DEMO_MODE=false
# LENS_OTLP_ENDPOINT=http://otel-collector:4318
# LENS_FLASK_ENV=production
